<div class="f8 f8-lp-sticky" id="f8-lp-sticky" role="complementary" aria-label="Offer">
  <span class="f8-lp-sticky__price"><small>First jar</small><strong>${{ settings.jar_sale_price }}</strong></span>
  <a class="f8-button" href="{{ settings.offer_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
  {% render 'f8-subscription-terms' %}
</div>
<script>
  /* Show the sticky bar only after the hero's button + renewal sentence have scrolled out of view.
     Without JavaScript the bar simply stays visible. */
  (function () {
    var bar = document.getElementById('f8-lp-sticky');
    var anchor = document.querySelector('.f8-lp-hero__copy .f8-sub-terms');
    if (!bar || !anchor || !('IntersectionObserver' in window)) return;
    bar.classList.add('f8-lp-sticky--hidden');
    new IntersectionObserver(function (entries) {
      bar.classList.toggle('f8-lp-sticky--hidden', entries[0].isIntersecting);
    }).observe(anchor);
  })();
</script>
{% schema %}
{
  "name": "LP: Sticky mobile button",
  "settings": [{ "type": "text", "id": "button_label", "label": "Button label", "default": "Start Subscription" }],
  "presets": [{ "name": "LP: Sticky mobile button" }]
}
{% endschema %}
