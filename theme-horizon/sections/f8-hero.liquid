{%- comment -%}
  First-page hero. The banner image already contains the jar and tagline,
  so the headline/CTA sit in a band below it rather than over the jar.
  Image is eager + high priority (it is the LCP element).
{%- endcomment -%}
<section class="f8 f8-hero">
  <picture class="f8-hero__media">
    {%- if section.settings.image == blank -%}
      <source media="(max-width: 749px)" srcset="{{ 'formul8-hero-mobile.webp' | asset_url }}" width="880" height="857" type="image/webp">
      <source srcset="{{ 'formul8-hero.webp' | asset_url }}" width="2000" height="857" type="image/webp">
    {%- endif -%}
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.alt, class: 'f8-hero__img' }}
    {%- else -%}
      <img class="f8-hero__img" src="{{ 'formul8-hero.jpg' | asset_url }}" width="2000" height="857"
           alt="{{ section.settings.alt | escape }}" loading="eager" fetchpriority="high">
    {%- endif -%}
  </picture>
  {%- if settings.site_mode == 'selling' and template.name != 'password' -%}
  <div class="f8-hero__content">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>
    {%- if section.settings.button_label != blank -%}
      <a class="f8-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
    {% render 'f8-subscription-terms' %}
    <p class="f8-guarantee-line">{% render 'f8-icon-check' %} {{ settings.guarantee_days }}-day money-back guarantee</p>
  </div>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image (leave empty to use the bundled jar banner)" },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "Formul8 Nutrition dietary supplement jar, 30 servings, in dark green packaging" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your gut. Your health. Your formula." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Formul8 Nutrition is a dietary supplement. Each jar contains 30 servings." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Formul8" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
