{%- comment -%}
  Planned-offer price call-out for the WAITLIST page (the product cannot be bought yet).
  Prices come from Theme settings -> Formul8 offer & stock (one source of truth).
  The crossed-out price is the monthly price and is crossed out ONLY next to the first-jar price; the recurring
  monthly price is always stated in plain words right below it. Never write "used to be", "was", "regular price",
  "launch price" or "one-time" here. A qualified reviewer must check this wording before launch.
{%- endcomment -%}
{%- if settings.site_mode != 'selling' or template.name == 'password' -%}
{%- liquid
  assign f8_pct = 0
  if settings.jar_regular_price > 0
    assign f8_pct = settings.jar_regular_price | minus: settings.jar_sale_price | times: 100.0 | divided_by: settings.jar_regular_price | round
  endif
-%}
<section class="f8 f8-offer" id="f8-offer">
  <p class="f8-offer__eyebrow">{{ section.settings.eyebrow | default: 'Planned for launch · subject to change' }}</p>
  <h2>{{ section.settings.heading }}</h2>
  <div class="f8-offer__card">
    <p class="f8-offer__price">
      <span class="f8-vh">Monthly price ${{ settings.jar_regular_price }}, crossed out. Your first jar: </span>
      <s class="f8-offer__was" aria-hidden="true">${{ settings.jar_regular_price }}</s>
      <strong class="f8-offer__now">${{ settings.jar_sale_price }}</strong>
      <span class="f8-offer__for">for your first jar{% if f8_pct > 0 %} ({{ f8_pct }}% off){% endif %}</span>
    </p>
    <p class="f8-offer__then">Then ${{ settings.jar_regular_price }} per month until you cancel.</p>
    <p class="f8-offer__gifts-line"><strong>Includes 2 FREE gifts</strong> with your first subscription delivery:</p>
  </div>
  <picture class="f8-gifts__media">
    <source media="(max-width: 749px)" srcset="{{ 'formul8-gifts-mobile.webp' | asset_url }}" width="880" height="857" type="image/webp">
    <source srcset="{{ 'formul8-gifts.webp' | asset_url }}" width="2000" height="857" type="image/webp">
    <img class="f8-gifts__img" src="{{ 'formul8-gifts.jpg' | asset_url }}" width="2000" height="857" alt="{{ section.settings.alt | escape }}" loading="lazy">
  </picture>
  <ul class="f8-gifts__cards">
    <li class="f8-gift-card"><h3>{{ settings.shaker_name }}</h3><p><strong>FREE</strong></p></li>
    <li class="f8-gift-card"><h3>{{ settings.frother_name }}</h3><p><strong>FREE</strong></p></li>
  </ul>
  <p class="f8-offer__cta"><a class="f8-button f8-button--lg" href="#f8-signup">{{ section.settings.button_label }}</a></p>
  <p class="f8-offer__note">{{ section.settings.note | default: 'Planned offer for waitlist members. Pricing, offer details and availability may change before launch, and Formul8 is not yet available to order. Full subscription terms, including how to cancel, will be shown before you buy.' }}</p>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Planned offer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label above heading", "default": "Planned for launch · subject to change" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your first jar, with 2 free gifts" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the waitlist" },
    { "type": "text", "id": "alt", "label": "Gifts photo description", "default": "Formul8 Nutrition green shaker bottle and hand blender/frother" },
    { "type": "textarea", "id": "note", "label": "Small print (keep it)", "default": "Planned offer for waitlist members. Pricing, offer details and availability may change before launch, and Formul8 is not yet available to order. Full subscription terms, including how to cancel, will be shown before you buy." }
  ],
  "presets": [{ "name": "Planned offer" }]
}
{% endschema %}
