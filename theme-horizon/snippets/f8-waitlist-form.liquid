{%- comment -%}
  Waitlist sign-up form, used in the top sign-up box AND in the story section (owner wording).
  Sign-ups become Shopify customers tagged "newsletter" (email marketing) and "waitlist".
  uid keeps every element id unique when the form appears more than once on a page.
{%- endcomment -%}
{%- assign f8_form_id = 'waitlist-form-' | append: uid -%}
<div class="f8-waitlist__join">
  {%- form 'customer', id: f8_form_id, class: 'f8-waitlist__form' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,waitlist">
    {%- if form.posted_successfully? -%}
      <p class="f8-waitlist__ok" role="status" tabindex="-1" autofocus>{% render 'f8-icon-check' %}<span>Thanks! You're on the waitlist.</span></p>
    {%- else -%}
      <h2>{{ heading }}</h2>
      <p>{{ text }}</p>
      {%- if form.errors -%}
        <div class="f8-waitlist__err" id="waitlist-error-{{ uid }}" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label for="waitlist-email-{{ uid }}">Email address</label>
      <div class="f8-waitlist__row">
        <input id="waitlist-email-{{ uid }}" type="email" name="contact[email]" autocomplete="email" required placeholder="you@example.com" value="{{ form.email }}"{% if form.errors %} aria-invalid="true" aria-describedby="waitlist-error-{{ uid }} waitlist-consent-{{ uid }}"{% else %} aria-describedby="waitlist-consent-{{ uid }}"{% endif %}>
        <button type="submit" class="f8-button">{{ button_label }}</button>
      </div>
      <p class="f8-waitlist__consent" id="waitlist-consent-{{ uid }}">By joining you agree to receive product development updates, early access news and launch offers by email. Unsubscribe any time.{% if shop.privacy_policy.url != blank %} <a href="{{ shop.privacy_policy.url }}">Privacy policy</a>{% endif %}</p>
    {%- endif -%}
  {%- endform -%}
</div>
