<section class="lp-faq">
  <h2>{{ section.settings.heading }}</h2>
  <details><summary>What is in Formul8 Nutrition?</summary><p>{{ section.settings.a_ingredients }}</p></details>
  <details><summary>How many servings are in a jar?</summary><p>Each jar contains 30 servings.</p></details>
  <details><summary>How do the free gifts work?</summary><p>Use the button on this page. It adds your jar and both free gifts to your cart, and the gifts show as FREE at checkout. Gifts are limited by stock.</p></details>
  <details><summary>What is the money-back guarantee?</summary><p>Your purchase is backed by our {{ settings.guarantee_days }}-day money-back guarantee. See our <a href="{{ routes.root_url }}policies/refund-policy">refund policy</a> for how it works.</p></details>
  <details><summary>What about shipping?</summary><p>{{ section.settings.a_shipping }}</p></details>
</section>
{% schema %}
{
  "name": "LP: FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "textarea", "id": "a_ingredients", "label": "Ingredients answer (UPDATE before publishing)", "default": "The Supplement Facts and full ingredient list will be shown on the product label and product page." },
    { "type": "textarea", "id": "a_shipping", "label": "Shipping answer (UPDATE with real terms)", "default": "Shipping options and costs are shown at checkout." }
  ],
  "presets": [{ "name": "LP: FAQ" }]
}
{% endschema %}
