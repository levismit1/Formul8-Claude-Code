{%- assign left = settings.gifts_left | plus: 0 -%}
{%- if left > 0 -%}
<div class="announce" role="status">
  <span class="stock-pill">Only {{ left }} left</span>
  <span>FREE shaker bottle + hand blender/frother with your Formul8 jar</span>
</div>
{%- endif -%}
<header class="site-header">
  <a class="site-header__logo" href="{{ routes.root_url }}">{{ shop.name }}</a>
  <nav class="site-header__nav" aria-label="Main">
    {% for link in linklists.main-menu.links %}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {% endfor %}
    <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
  </nav>
</header>
{% schema %}
{ "name": "Header" }
{% endschema %}
