<section class="lp-reasons">
  <h2>{{ section.settings.heading }}</h2>
  <ol class="lp-reasons__list">
    <li class="reason"><span class="reason__n">1</span><div><h3>Your formula.</h3>
      <p>Formul8 Nutrition: Your gut. Your health. Your formula.</p></div></li>
    <li class="reason"><span class="reason__n">2</span><div><h3>30 servings in every jar.</h3>
      <p>One jar of Formul8 Nutrition contains 30 servings.</p></div></li>
    <li class="reason"><span class="reason__n">3</span><div><h3>30% off your first jar.</h3>
      <p>${{ settings.jar_sale_price }} for your first jar, then ${{ settings.jar_regular_price }} per month until you cancel. {{ settings.cancel_text }}.</p></div></li>
    <li class="reason"><span class="reason__n">4</span><div><h3>A free shaker bottle.</h3>
      <p>Yours free with your first subscription delivery.</p></div></li>
    <li class="reason"><span class="reason__n">5</span><div><h3>A free hand blender/frother.</h3>
      <p>Yours free with your first subscription delivery.</p></div></li>
  </ol>
  <picture class="lp-reasons__media">
    <source media="(max-width: 749px)" srcset="{{ 'formul8-gifts-mobile.webp' | asset_url }}" width="880" height="857" type="image/webp">
    <source srcset="{{ 'formul8-gifts.webp' | asset_url }}" width="2000" height="857" type="image/webp">
    <img src="{{ 'formul8-gifts.jpg' | asset_url }}" width="2000" height="857" alt="{{ section.settings.alt | escape }}" loading="lazy">
  </picture>
  <p class="lp-center"><a class="button button--lg" href="{{ settings.offer_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></p>
  {% render 'subscription-terms' %}
</section>
{% schema %}
{
  "name": "LP: 5 reasons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why you'll love it" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Start My Subscription + Free Gifts" },
    { "type": "text", "id": "alt", "label": "Gifts image description", "default": "Formul8 Nutrition green shaker bottle and hand blender/frother" }
  ],
  "presets": [{ "name": "LP: 5 reasons" }]
}
{% endschema %}
