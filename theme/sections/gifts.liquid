{%- comment -%}
  Free-gift showcase. Prices below are the gifts' normal prices (owner-confirmed).
  The green "In stock" badge shows only while the theme setting `gifts_left` is above 0 (hidden at 0/blank).
  It must always match real inventory.
{%- endcomment -%}
{%- assign left = settings.gifts_left | plus: 0 -%}
{%- assign total = settings.shaker_price | plus: settings.frother_price -%}
<section class="gifts">
  <div class="gifts__head">
    <h2>{{ section.settings.heading }}</h2>
    <p>Yours free when you get Formul8 Nutrition. That is ${{ total | round: 2 }} of free gifts.</p>
    {%- if left > 0 -%}
      <p class="stock-pill stock-pill--lg" role="status">In stock</p>
    {%- endif -%}
  </div>
  <picture class="gifts__media">
    <source media="(max-width: 749px)" srcset="{{ 'formul8-gifts-mobile.webp' | asset_url }}" type="image/webp">
    <source srcset="{{ 'formul8-gifts.webp' | asset_url }}" type="image/webp">
    <img class="gifts__img" src="{{ 'formul8-gifts.jpg' | asset_url }}" width="2000" height="857"
         alt="{{ section.settings.alt | escape }}" loading="lazy">
  </picture>
  <ul class="gifts__cards">
    <li class="gift-card">
      <h3>{{ settings.shaker_name }}</h3>
      <p><s>${{ settings.shaker_price }}</s> <strong>FREE</strong></p>
    </li>
    <li class="gift-card">
      <h3>{{ settings.frother_name }}</h3>
      <p><s>${{ settings.frother_price }}</s> <strong>FREE</strong></p>
    </li>
  </ul>
  {%- if left > 0 -%}
    <p class="gifts__note stock-text">Free gift sets are in stock.</p>
  {%- endif -%}
  <p class="gifts__cta"><a class="button" href="{{ settings.offer_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></p>
</section>
{% schema %}
{
  "name": "Free gifts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 2 free gifts with your jar" },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "Formul8 Nutrition green shaker bottle and hand blender/frother" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Claim 30% off + free gifts" }
  ],
  "presets": [{ "name": "Free gifts" }]
}
{% endschema %}
