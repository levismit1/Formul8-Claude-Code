{%- comment -%}
  Free-gift showcase. Prices below are the gifts' normal prices (owner-confirmed).
  The red "Only X left" message reads the theme setting `gifts_left` and hides at 0/blank.
  It must always match real inventory.
{%- endcomment -%}
{%- assign left = settings.gifts_left | plus: 0 -%}
{%- assign total = section.settings.shaker_price | plus: section.settings.frother_price -%}
<section class="gifts">
  <div class="gifts__head">
    <h2>{{ section.settings.heading }}</h2>
    <p>Yours free when you get Formul8 Nutrition. That is ${{ total | round: 2 }} of free gifts.</p>
    {%- if left > 0 -%}
      <p class="stock-pill stock-pill--lg" role="status">Only {{ left }} left in stock!</p>
    {%- endif -%}
  </div>
  <picture class="gifts__media">
    <source media="(max-width: 749px)" srcset="{{ 'formul8-gifts-mobile.webp' | asset_url }}" type="image/webp">
    <source srcset="{{ 'formul8-gifts.webp' | asset_url }}" type="image/webp">
    <img class="gifts__img" src="{{ 'formul8-gifts.jpg' | asset_url }}" width="2000" height="857"
         alt="{{ section.settings.alt | escape }}" loading="lazy">
  </picture>
  <ul class="gifts__cards">
    <li class="gift-card">
      <h3>{{ section.settings.shaker_name }}</h3>
      <p><s>${{ section.settings.shaker_price }}</s> <strong>FREE</strong></p>
    </li>
    <li class="gift-card">
      <h3>{{ section.settings.frother_name }}</h3>
      <p><s>${{ section.settings.frother_price }}</s> <strong>FREE</strong></p>
    </li>
  </ul>
  {%- if left > 0 -%}
    <p class="gifts__note stock-text">Only {{ left }} free-gift sets left. When they are gone, they are gone.</p>
  {%- endif -%}
  <p class="gifts__cta"><a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></p>
</section>
{% schema %}
{
  "name": "Free gifts",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 2 free gifts with your jar" },
    { "type": "text", "id": "alt", "label": "Image description (alt text)", "default": "Formul8 Nutrition green shaker bottle and hand blender/frother" },
    { "type": "text", "id": "shaker_name", "label": "Shaker name", "default": "Formul8 Shaker Bottle" },
    { "type": "number", "id": "shaker_price", "label": "Shaker normal price ($)", "default": 14.99 },
    { "type": "text", "id": "frother_name", "label": "Frother name", "default": "Formul8 Hand Blender / Frother" },
    { "type": "number", "id": "frother_price", "label": "Frother normal price ($)", "default": 24.99 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Claim 30% off + free gifts" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Free gifts" }]
}
{% endschema %}
