<div class="lp-sticky" role="complementary" aria-label="Offer">
  <span class="lp-sticky__price"><small>First jar</small><strong>${{ settings.jar_sale_price }}</strong>{% render 'subscription-terms', compact: true %}</span>
  <a class="button" href="{{ settings.offer_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
</div>
{% schema %}
{
  "name": "LP: Sticky mobile button",
  "settings": [{ "type": "text", "id": "button_label", "label": "Button label", "default": "Start Subscription" }],
  "presets": [{ "name": "LP: Sticky mobile button" }]
}
{% endschema %}
