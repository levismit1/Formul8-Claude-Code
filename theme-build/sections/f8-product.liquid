{%- comment -%}
  Product page. Sold only as a subscription: the buy button sends the first selling plan of the product
  (created by the owner in the Shopify Subscriptions app). Card details are entered on Shopify's own
  secure checkout page, never on this site.
  Free gifts are added to the cart only when the owner ticks "Add the two free gifts" (after the two gift
  discounts are active and tested), otherwise the customer would be charged for them.
{%- endcomment -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign plan = product.selling_plan_groups.first.selling_plans.first -%}
{%- comment -%} Products of type "Accessory" are the free gifts: no price, no buy button, "not sold separately". {%- endcomment -%}
{%- assign is_gift = false -%}
{%- if product.type == 'Accessory' -%}{%- assign is_gift = true -%}{%- endif -%}
<div class="f8">
<section class="pdp">
  <div class="pdp__media">
    {%- for image in product.images limit: 6 -%}
      {{ image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: image.alt | default: product.title }}
    {%- else -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ 'formul8-hero-mobile.webp' | asset_url }}" type="image/webp">
        <img src="{{ 'formul8-hero.jpg' | asset_url }}" width="2000" height="857" alt="Formul8 Nutrition dietary supplement jar, 30 servings, in dark green packaging">
      </picture>
    {%- endfor -%}
  </div>

  <div class="pdp__info">
    <h1 class="pdp__title">{{ product.title }}</h1>
    {%- if settings.gifts_in_stock and variant.available and is_gift == false -%}<p class="stock-pill" role="status">In stock</p>{%- endif -%}
        {%- if is_gift -%}
      <p class="pdp__lead"><strong>Free gift with your first Formul8 subscription delivery.</strong> Not sold separately.</p>
      <p><a class="f8-button f8-button--lg pdp__buy" href="{{ settings.offer_link | default: routes.all_products_collection_url }}">See the Formul8 subscription</a></p>
    {%- else -%}
    {%- if section.settings.short_text != blank -%}<p class="pdp__lead">{{ section.settings.short_text }}</p>{%- endif -%}

    {%- if variant.available -%}
      {%- assign once_price = variant.price | money_without_trailing_zeros -%}
      <form method="post" action="{{ routes.cart_add_url }}" class="pdp__form" id="f8-buy-form" data-cart-url="{%- if section.settings.discount_code != blank -%}/discount/{{ section.settings.discount_code | url_encode }}?redirect={{ routes.cart_url | url_encode }}{%- else -%}{{ routes.cart_url }}{%- endif -%}"
            data-jar="{{ variant.id }}" data-plan="{{ plan.id }}"
            data-label-sub="{{ section.settings.button_label | escape }}" data-label-once="{{ section.settings.button_label_once | escape }}"
            {%- if section.settings.add_gifts -%}
              {%- assign g1 = section.settings.gift_shaker.selected_or_first_available_variant -%}
              {%- assign g2 = section.settings.gift_frother.selected_or_first_available_variant -%}
              {%- if g1.available and g2.available %} data-gifts="{{ g1.id }},{{ g2.id }}"{% endif -%}
            {%- endif -%}>
        <input type="hidden" name="id" value="{{ variant.id }}">
        <input type="hidden" name="quantity" value="1">
        {%- if section.settings.discount_code != blank -%}
          <input type="hidden" name="return_to" value="/discount/{{ section.settings.discount_code | url_encode }}?redirect={{ routes.cart_url | url_encode }}">
        {%- endif -%}
        <fieldset class="pdp__choices">
          <legend class="pdp__choices-title">Choose how to buy</legend>
          {%- if plan -%}
            <label class="pdp__choice">
              <input type="radio" name="selling_plan" value="{{ plan.id }}" checked data-mode="sub">
              <span><strong>Subscribe</strong> &ndash; ${{ settings.jar_sale_price }} for your first jar, then ${{ settings.jar_regular_price }} per month</span>
            </label>
          {%- endif -%}
          <label class="pdp__choice">
            <input type="radio" name="selling_plan" value="" {% unless plan %}checked{% endunless %} data-mode="once">
            <span><strong>Buy once</strong> &ndash; {{ once_price }}</span>
          </label>
        </fieldset>
        <button type="submit" class="f8-button f8-button--lg pdp__buy" id="f8-buy-btn">{% if plan %}{{ section.settings.button_label }}{% else %}{{ section.settings.button_label_once }}{% endif %}</button>
        <p class="pdp__err" id="f8-buy-error" role="alert" hidden>Sorry, we could not add this to your cart. Please try again.</p>
      </form>
    {%- else -%}
      <p><span class="f8-button f8-button--lg pdp__buy" aria-disabled="true">Sold out</span></p>
    {%- endif -%}
    <div id="f8-terms-sub"{% unless plan %} hidden{% endunless %}>{% render 'f8-subscription-terms' %}</div>
    <p class="sub-terms" id="f8-terms-once"{% if plan %} hidden{% endif %}>One-time purchase: {{ once_price }}. This does not start a subscription.</p>
    <p class="guarantee-line">{% render 'f8-icon-check' %} {{ settings.guarantee_days }}-day money-back guarantee</p>
    <p class="pdp__secure">You will enter your card details on Shopify's secure checkout page.</p>

    <div class="pdp__gifts">
      <h2>Free with your first subscription delivery</h2>
      <ul>
        <li>{{ settings.shaker_name }}</li>
        <li>{{ settings.frother_name }}</li>
      </ul>
    </div>
    {%- endif -%}

    <div class="pdp__desc">{{ product.description }}</div>

    {%- unless is_gift -%}
    <details class="pdp__facts">
      <summary>Supplement Facts</summary>
      <p>{{ section.settings.facts_text }}</p>
    </details>
    {%- endunless -%}
    <p class="pdp__fda">These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
  </div>
</section>
</div>
<script>
  (function () {
    var form = document.getElementById('f8-buy-form');
    if (!form) return;
    var btn = document.getElementById('f8-buy-btn'), err = document.getElementById('f8-buy-error');
    var tSub = document.getElementById('f8-terms-sub'), tOnce = document.getElementById('f8-terms-once');
    function isSub() { var r = form.querySelector('input[name="selling_plan"]:checked'); return !!(r && r.value); }
    function sync() {
      var sub = isSub();
      tSub.hidden = !sub; tOnce.hidden = sub;
      btn.textContent = sub ? form.dataset.labelSub : form.dataset.labelOnce;
    }
    form.addEventListener('change', sync); sync();
    if (!window.fetch) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      btn.disabled = true; err.hidden = true;
      var sub = isSub();
      var item = { id: Number(form.dataset.jar), quantity: 1 };
      if (sub) item.selling_plan = Number(form.dataset.plan);
      var items = [item];
      if (sub) (form.dataset.gifts || '').split(',').filter(Boolean).forEach(function (id) { items.push({ id: Number(id), quantity: 1 }); });
      fetch('{{ routes.cart_add_url }}.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
        .then(function (r) { if (!r.ok) throw new Error('add failed'); window.location.href = sub ? form.dataset.cartUrl : '{{ routes.cart_url }}'; })
        .catch(function () { btn.disabled = false; err.hidden = false; });
    });
  })();
</script>
{% schema %}
{
  "name": "Formul8 product",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label (Subscribe)", "default": "Start My Subscription" },
    { "type": "text", "id": "button_label_once", "label": "Button label (Buy once)", "default": "Add to Cart" },
    { "type": "textarea", "id": "short_text", "label": "Short intro", "default": "Formul8 Nutrition is a dietary supplement. Each jar contains 30 servings." },
    { "type": "textarea", "id": "facts_text", "label": "Supplement Facts (placeholder until the final label exists)", "default": "Supplement Facts panel, ingredient list and directions will be added here from the final label. This product is not available to buy until they are." },
    { "type": "text", "id": "discount_code", "label": "First-jar discount code (applied automatically)", "default": "FIRST30", "info": "Shopify discount: 30% off the first payment of a subscription. Leave empty for none." },
    { "type": "header", "content": "Free gifts" },
    { "type": "checkbox", "id": "add_gifts", "label": "Add the two free gifts to the cart with the jar", "default": false, "info": "Tick ONLY after both gift discounts are active and tested, otherwise customers would be charged for the gifts." },
    { "type": "product", "id": "gift_shaker", "label": "Gift 1: shaker bottle product" },
    { "type": "product", "id": "gift_frother", "label": "Gift 2: hand blender / frother product" }
  ]
}
{% endschema %}
