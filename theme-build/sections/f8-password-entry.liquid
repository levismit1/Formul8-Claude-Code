<div class="f8">
{%- comment -%}
  Lets the store owner (and invited reviewers) enter the storefront password while the public sees the waitlist.
{%- endcomment -%}
<section class="pw-entry">
  <details>
    <summary>{{ section.settings.summary }}</summary>
    {%- form 'storefront_password', class: 'pw-entry__form' -%}
      {%- if form.errors -%}<div class="waitlist__err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label for="Password">Password</label>
      <div class="waitlist__row">
        <input type="password" name="password" id="Password" autocomplete="current-password" required>
        <button type="submit" class="f8-button">Enter</button>
      </div>
    {%- endform -%}
  </details>
</section>
</div>
{% schema %}
{
  "name": "Password entry",
  "settings": [
    { "type": "text", "id": "summary", "label": "Link text", "default": "Store owner? Enter using password" }
  ],
  "presets": [{ "name": "Password entry" }]
}
{% endschema %}
